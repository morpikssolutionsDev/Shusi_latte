# Sushi Latte environment variables. Copy to .env and fill in; .env is git-ignored.
# `pnpm dev`, `pnpm seed`, `pnpm demo` and `pnpm test-api` load .env (scripts/run.mjs); a variable
# already set in the shell wins. Running `go` directly does not read it.

# --- Required -----------------------------------------------------------------

# PostgreSQL database (ADR-0007). The demo lives in schema `app`; tests use throwaway `test_…` schemas.
POSTGRE_URL=postgres://postgres:<password>@localhost:5432/sushi_latte?sslmode=disable

# --- API (api/internal/config) — all optional ----------------------------------

# Listen address; Caddy fronts it on the LAN.
SL_ADDR=127.0.0.1:8080
# Runtime data: crypto-shredding keys, images. Default ../data (relative to api/).
SL_DATA_DIR=../data
# Demo photos copied by the seed. Default ../docs/images.
SL_ASSETS_DIR=../docs/images
# Demo mode (reset, launcher, nightly reset). `pnpm dev`/`seed`/`demo` set it to true.
SL_DEMO_MODE=false
# Secure session cookies (browsers allow them on localhost).
SL_SECURE_COOKIE=true
# Comma-separated host patterns accepted for WebSocket origins.
SL_WS_ORIGINS=localhost:*,127.0.0.1:*
# debug | info | warn | error
SL_LOG_LEVEL=info
# Base64 32-byte key wrapping the daily data keys (TR-RET-04). Empty = use data/master.key.
SL_MASTER_KEY=

# --- Web apps (Vite) — all optional --------------------------------------------

# API the Vite dev servers proxy to.
SL_API_URL=http://127.0.0.1:8080
# Links from the Client Menu launcher and Admin.
VITE_STAFF_URL=/staff/
VITE_DISPLAY_URL=/display/
# Origin printed into Table QR codes; leave unset to use the page's own origin
# (an empty value would print bare paths).
# VITE_MENU_ORIGIN=https://192.168.1.10:8443
